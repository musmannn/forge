{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.1.0",
  "identifier": "dev.forge.monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Forge",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 260,
        "backgroundColor": "#1a1d21"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "System monitor and task manager",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
